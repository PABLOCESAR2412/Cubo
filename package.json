{
  "name": "cubo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "test": "bun test tests",
    "lint": "biome check apps packages scripts tests package.json tsconfig.json biome.json",
    "format": "biome check --write apps packages scripts tests package.json tsconfig.json biome.json",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "deploy": "bun run scripts/deploy.ts",
    "db:migrate": "wrangler d1 migrations apply cubo-dev-db --local --config apps/api/wrangler.jsonc",
    "check:browser": "bun run scripts/browser-check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@cloudflare/workers-types": "5.20261013.1",
    "@cubo/database": "workspace:*",
    "@cubo/providers": "workspace:*",
    "@cubo/runner": "workspace:*",
    "@cubo/shared": "workspace:*",
    "@cubo/tasks": "workspace:*",
    "@playwright/test": "^1.58.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jose": "^6.0.0",
    "typescript": "^5.9.0",
    "wrangler": "4.149.0"
  }
}
